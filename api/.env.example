DB_USER=jobspy_user
DB_PASSWORD=jobspy_pass
DB_HOST=db
DB_PORT=5432
DB_NAME=jobspy_db

REDIS_HOST=redis
REDIS_PORT=6379

# JWT
SECRET_KEY=<output of: openssl rand -hex 32>
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=<minutes>
REFRESH_TOKEN_EXPIRE_DAYS=<days>

# CORS
BACKEND_CORS_ORIGINS=[]

# Environment
ENVIRONMENT=development
DEBUG=true

